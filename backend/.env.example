PORT=5100
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here

# Clerk Authentication - Get these from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key-here

# AI Provider Selection - Choose 'gemini', 'ollama', or 'document-intelligence'
AI_PROVIDER=document-intelligence

# Document Intelligence API Configuration - Only used when AI_PROVIDER=document-intelligence
# This is a standalone service that handles OCR + LLM summarization for PDF, PNG, and JPEG files
DOCUMENT_INTELLIGENCE_API_URL=https://docsummary.shaihulud.org/api/v1
DOCUMENT_INTELLIGENCE_API_KEY=your-api-key-here
DOCUMENT_INTELLIGENCE_PROMPT=You are an expert car appraiser. Analyze this document and provide key details, condition assessment, and negotiation opportunities.

# Gemini AI Prompts - Customize these for your use case
GEMINI_TEXT_PROMPT="Please provide a concise summary of the following document content.:\n\n"
GEMINI_PDF_PROMPT="Please analyze this PDF document and provide a concise summary."

# Ollama Configuration - Only used when AI_PROVIDER=ollama
# New workflow: PDF → PNG (pdftocairo) → Tesseract OCR → Ollama text summarization
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=60000
OLLAMA_TEXT_PROMPT="You are an expert car appraiser and negotiation advisor. Analyze this car document and provide:\n\n1. KEY VEHICLE DETAILS: Make, model, year, mileage, VIN, registration info\n2. CONDITION ASSESSMENT: Note any mentioned damage, wear, or issues\n3. NEGOTIATION OPPORTUNITIES: Identify 2-3 specific points where you could negotiate a better price\n4. MONEY-SAVING TIPS: Suggest where to save costs and negotiate better\n\nBe specific and actionable.\n\nDocument text:\n"
# Note: Ollama is now used only for text summarization, not OCR (Tesseract handles OCR)
